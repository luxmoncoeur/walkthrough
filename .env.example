# Optional GitHub personal access token: raises the API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# Groq API key, required for tour generation. Free key from console.groq.com.
GROQ_API_KEY=
# Optional, Preview/Development only. "1" enables ?sabotage= failure injection (docs/FAILURES.md). Never set in Production.
ENABLE_SABOTAGE=
